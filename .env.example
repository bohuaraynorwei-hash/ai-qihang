# ===== 必填：管理台密码（/admin 页面用，猜不到的那种）=====
ADMIN_PASSWORD=change-me-please

# ===== 建议填：定时抓取用的密钥 =====
# Vercel Cron 触发时会自动带上 Authorization: Bearer $CRON_SECRET
# 没填的话：非生产环境放行、生产环境直接 503（防止被人刷）
CRON_SECRET=

# ===== 必填（否则知识库无法持久化，每天抓完就没了）=====
# Vercel 里安装 Upstash Redis 后会自动注入下面两个变量：
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 如果是直接装 Upstash（不是 Vercel 集成），用这两个名字也可以：
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===== 可选：抓取时用大模型写中文摘要 =====
# 不填也能跑，只是摘要会直接用原文前 200 字。更推荐在 /admin 页面里配（存进 Redis，随时能改）。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
